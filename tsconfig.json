{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    /* Layer 1 (engine) is pure and headless. We deliberately DO NOT include the
       "DOM" lib here, so `document`/`window`/etc. are not even typed inside the
       engine — the type system physically enforces the engine/view wall (§4).
       When the view is added (prompts 13–14) it gets its own tsconfig with DOM. */
    "lib": ["ES2022"],
    "types": ["node"],

    /* Strictness: this is a determinism-critical, TDD-first engine. Err strict. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "noEmit": true
  },
  "include": ["src", "harness", "tests", "vitest.config.ts"],

  /* The view (Layer 3) is the one place DOM types are allowed. It is compiled by
     `tsconfig.view.json`, which turns the DOM lib back on. Excluding it here is what
     keeps `document`/`window` un-typed — and therefore un-referenceable — everywhere
     in the engine, harness, and engine tests. That un-typing is the enforcement. */
  "exclude": ["src/view", "tests/view"]
}
